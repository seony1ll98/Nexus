# ============================================================
# Nexus Docker 환경변수 설정
# 이 파일을 .env로 복사한 뒤 값을 수정하여 사용
# cp .env.docker.example .env
# ============================================================

# --- PostgreSQL ---
POSTGRES_DB=nexus
POSTGRES_USER=nexus
POSTGRES_PASSWORD=changeme_secure_password
POSTGRES_PORT=5432

# --- Backend ---
# 세션 시크릿 (반드시 변경)
SESSION_SECRET=changeme_random_secret_at_least_32_chars

# 최초 배포 시 생성할 관리자 계정 비밀번호 (admin@nexus.com)
# 이 값이 없으면 시드를 건너뛰어 로그인할 계정이 없는 상태가 된다.
# 최초 로그인 후 반드시 변경할 것. 계정이 이미 있으면 이 값은 무시된다.
ADMIN_SEED_PASSWORD=changeme_admin_password

# 외부 노출 포트
BACKEND_PORT=8080

# 프론트엔드 URL (CORS 허용 origin)
FRONTEND_URL=http://localhost:3000

# 신뢰할 리버스 프록시 주소 (쉼표 구분)
# Nginx를 앞단에 둘 때만 의미가 있다 — 여기 등록된 주소가 붙인
# X-Forwarded-For만 신뢰해 실제 클라이언트 IP를 판정한다.
TRUSTED_PROXIES=127.0.0.1,::1

# --- Frontend ---
# API 서버 URL (브라우저에서 접근하는 주소)
NEXT_PUBLIC_API_URL=http://localhost:8080

# 외부 노출 포트
FRONTEND_PORT=3000

# AES-256-GCM 암호화 키 — node -e "console.log(require(\"crypto\").randomBytes(32).toString(\"hex\"))" 로 생성
ENCRYPTION_KEY=
